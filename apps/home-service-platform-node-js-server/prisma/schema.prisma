datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ServiceProvider {
  availability      String?
  bio               String?
  booking           Booking?          @relation(name: "BookingOnServiceProviders", fields: [bookingId], references: [id])
  bookingId         String?
  bookings          Booking[]         @relation(name: "BookingsOnServiceProvider")
  createdAt         DateTime          @default(now())
  email             String?
  hourlyRate        Float?
  id                String            @id @default(cuid())
  name              String?
  phone             String?
  ratings           String?
  review            Review?           @relation(name: "ReviewOnServiceProviders", fields: [reviewId], references: [id])
  reviewId          String?
  reviews           Review[]          @relation(name: "ReviewsOnServiceProvider")
  serviceCategories ServiceCategory[]
  serviceType       String?
  updatedAt         DateTime          @updatedAt
}

model ServiceCategory {
  bookings          Booking[]
  categoryName      String?
  createdAt         DateTime         @default(now())
  description       String?
  id                String           @id @default(cuid())
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  serviceProviderId String?
  updatedAt         DateTime         @updatedAt
}

model Admin {
  booking     Booking? @relation(fields: [bookingId], references: [id])
  bookingId   String?
  createdAt   DateTime @default(now())
  email       String?
  id          String   @id @default(cuid())
  name        String?
  permissions String?
  review      Review?  @relation(fields: [reviewId], references: [id])
  reviewId    String?
  role        String?
  updatedAt   DateTime @updatedAt
}

model Booking {
  admins            Admin[]
  bookingDate       DateTime?
  createdAt         DateTime          @default(now())
  id                String            @id @default(cuid())
  paymentStatus     String?
  serviceCategory   ServiceCategory?  @relation(fields: [serviceCategoryId], references: [id])
  serviceCategoryId String?
  serviceProvider   ServiceProvider?  @relation(name: "BookingsOnServiceProvider", fields: [serviceProviderId], references: [id])
  serviceProviderId String?
  serviceProviders  ServiceProvider[] @relation(name: "BookingOnServiceProviders")
  status            String?
  updatedAt         DateTime          @updatedAt
  user              User?             @relation(fields: [userId], references: [id])
  userId            String?
}

model Review {
  admins            Admin[]
  comment           String?
  createdAt         DateTime          @default(now())
  id                String            @id @default(cuid())
  rating            Int?
  serviceProvider   ServiceProvider?  @relation(name: "ReviewsOnServiceProvider", fields: [serviceProviderId], references: [id])
  serviceProviderId String?
  serviceProviders  ServiceProvider[] @relation(name: "ReviewOnServiceProviders")
  updatedAt         DateTime          @updatedAt
  user              User?             @relation(fields: [userId], references: [id])
  userId            String?
}

model User {
  address        String?
  bookings       Booking[]
  createdAt      DateTime  @default(now())
  email          String?   @unique
  firstName      String?
  id             String    @id @default(cuid())
  lastName       String?
  name           String?
  password       String
  paymentMethods String?
  phone          String?
  reviews        Review[]
  roles          Json
  updatedAt      DateTime  @updatedAt
  username       String    @unique
}
